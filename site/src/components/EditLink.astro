---
// Generated pages (the reference, the changelog) aren't edited directly: point their
// "Edit page" link at what they're generated from.
import Default from '@astrojs/starlight/components/EditLink.astro';
import { Icon } from '@astrojs/starlight/components';

const { id } = Astro.locals.starlightRoute;
const repo = 'https://github.com/c3d-gg/melvor-script';
const source = id.startsWith('reference')
  ? { href: `${repo}/blob/main/src/client/melvor.ts`, label: 'Edit the doc comments this page is made from' }
  : id === 'changelog'
    ? { href: `${repo}/blob/main/CHANGELOG.md`, label: 'Written by the release script from commit messages' }
    : null;
---

{
  source ? (
    <a href={source.href} class="sl-flex print:hidden">
      <Icon name="pencil" size="1.2em" />
      {source.label}
    </a>
  ) : (
    <Default />
  )
}

<style>
  a {
    gap: 0.5rem;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>

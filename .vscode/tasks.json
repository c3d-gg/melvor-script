{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: watch + hot-reload runtime",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
        "background": { "activesBegin": "^\\[watch\\] build started", "endsPattern": "^\\[watch\\] build finished" }
      }
    },
    {
      "label": "watch game events",
      "type": "shell",
      "command": "bun run melvor watch",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
